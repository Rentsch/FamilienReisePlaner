// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TrailerType {
  CARGO
  BIKE_RACK
}

enum SeatRow {
  FRONT
  BACK
}

// ---- Stammdaten (owned by the admin, reusable across trips) ----

// Groups multiple People (each still their own participant/login) under one
// display name, e.g. so their packing lists can be shown together.
model Family {
  id          String   @id @default(cuid())
  adminUserId String
  name        String // Anzeigename, shown on the shared packing list
  createdAt   DateTime @default(now())

  people Person[]

  @@unique([adminUserId, name])
}

model Person {
  id           String  @id @default(cuid())
  adminUserId  String // Supabase auth.users.id
  name         String
  canDrive     Boolean @default(false)
  backSeatOnly Boolean @default(false) // e.g. children who may only sit in the back
  photoUrl     String?
  familyId     String?
  family       Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  participations TripParticipant[]

  @@unique([adminUserId, name])
}

model Vehicle {
  id          String  @id @default(cuid())
  adminUserId String
  name        String
  seats       Int
  frontSeats  Int     @default(2) // includes the driver's seat
  hasTowHitch Boolean @default(false)

  tripVehicles TripVehicle[]
}

model Trailer {
  id          String      @id @default(cuid())
  adminUserId String
  name        String
  type        TrailerType
  capacity    Int?

  tripTrailers TripTrailer[]
}

// ---- Trip + participation (a person/vehicle/trailer opting into one trip) ----

model Trip {
  id          String    @id @default(cuid())
  name        String
  description String?
  date        DateTime?
  shareToken  String    @unique @default(cuid())
  adminUserId String
  createdAt   DateTime  @default(now())

  // Travel time for this trip's route, depending on what's being towed.
  travelTimeMinutes                 Int?
  travelTimeWithBikeTrailerMinutes  Int?
  travelTimeWithCargoTrailerMinutes Int?
  // Prefilled as the departure time for every vehicle when a new variant is created;
  // adjustable per vehicle within the variant itself. Stored as "HH:MM".
  defaultDepartureTime              String?

  participants TripParticipant[]
  tripVehicles TripVehicle[]
  tripTrailers TripTrailer[]
  variants     Variant[]
  appointments Appointment[]
  packingItems TripPackingItem[]
}

// ---- Packing lists ----

// Admin-owned, reusable list of items (e.g. "Camping-Ausrüstung") that can be
// attached to a trip. Attaching copies the items as a one-time snapshot.
model PackingListTemplate {
  id          String   @id @default(cuid())
  adminUserId String
  name        String
  createdAt   DateTime @default(now())

  items PackingListTemplateItem[]
}

model PackingListTemplateItem {
  id         String               @id @default(cuid())
  templateId String
  template   PackingListTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
}

// A shared, one-off item on a trip's packing list (e.g. "Erste-Hilfe-Set").
// At most one participant can claim it; only that participant may release it.
model TripPackingItem {
  id                     String           @id @default(cuid())
  tripId                 String
  trip                   Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name                   String
  claimedByParticipantId String?
  claimedBy              TripParticipant? @relation(fields: [claimedByParticipantId], references: [id])
  isPacked               Boolean          @default(false)
  createdAt              DateTime         @default(now())

  @@index([tripId])
}

// A single entry in a trip's daily schedule ("Tagesablauf").
model Appointment {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  title     String
  address   String
  createdAt DateTime @default(now())

  attachments AppointmentAttachment[]

  @@index([tripId, date])
}

// A file (image or PDF) attached to a schedule entry, stored in Supabase Storage.
model AppointmentAttachment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  url           String
  filename      String
  mimeType      String
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

model TripParticipant {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id])
  hasBike  Boolean @default(false)

  createdVariants     Variant[]          @relation("VariantCreator")
  personAssignments   PersonAssignment[]
  bikeAssignments     BikeAssignment[]
  votes               Vote[]
  claimedPackingItems TripPackingItem[]

  @@unique([tripId, personId])
}

model TripVehicle {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  personAssignments  PersonAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]

  @@unique([tripId, vehicleId])
}

model TripTrailer {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  trailerId String
  trailer   Trailer @relation(fields: [trailerId], references: [id])

  trailerAssignments TrailerAssignment[]
  bikeAssignments    BikeAssignment[]

  @@unique([tripId, trailerId])
}

// ---- Variants (assignment proposals) ----

model Variant {
  id                     String          @id @default(cuid())
  tripId                 String
  trip                   Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name                   String
  createdByParticipantId String
  createdBy              TripParticipant @relation("VariantCreator", fields: [createdByParticipantId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  personAssignments  PersonAssignment[]
  bikeAssignments    BikeAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]
  votes              Vote[]
}

model PersonAssignment {
  id                String          @id @default(cuid())
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripParticipantId String
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  tripVehicleId     String
  tripVehicle       TripVehicle     @relation(fields: [tripVehicleId], references: [id])
  row               SeatRow
  isDriver          Boolean         @default(false)

  @@unique([variantId, tripParticipantId])
}

// A bike belongs to a trip participant (only meaningful when hasBike=true).
// Bikes only ever attach to a BIKE_RACK trailer, never directly to a vehicle.
model BikeAssignment {
  id                String          @id @default(cuid())
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripParticipantId String
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  tripTrailerId     String
  tripTrailer       TripTrailer     @relation(fields: [tripTrailerId], references: [id])

  @@unique([variantId, tripParticipantId])
}

model TrailerAssignment {
  id            String      @id @default(cuid())
  variantId     String
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripTrailerId String
  tripTrailer   TripTrailer @relation(fields: [tripTrailerId], references: [id])
  tripVehicleId String
  tripVehicle   TripVehicle @relation(fields: [tripVehicleId], references: [id])

  @@unique([variantId, tripTrailerId])
}

model VariantVehiclePlan {
  id                        String      @id @default(cuid())
  variantId                 String
  variant                   Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripVehicleId             String
  tripVehicle               TripVehicle @relation(fields: [tripVehicleId], references: [id])
  departureTime             DateTime?
  travelTimeOverrideMinutes Int?

  @@unique([variantId, tripVehicleId])
}

model Vote {
  id                String          @id @default(cuid())
  tripId            String
  tripParticipantId String          @unique
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @updatedAt

  @@index([tripId])
}
