// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TrailerType {
  CARGO
  BIKE_RACK
}

enum SeatRow {
  FRONT
  BACK
}

// ---- Stammdaten (owned by the admin, reusable across trips) ----

model Person {
  id           String  @id @default(cuid())
  adminUserId  String // Supabase auth.users.id
  name         String
  canDrive     Boolean @default(false)
  backSeatOnly Boolean @default(false) // e.g. children who may only sit in the back
  photoUrl     String?

  participations TripParticipant[]

  @@unique([adminUserId, name])
}

model Vehicle {
  id                           String  @id @default(cuid())
  adminUserId                  String
  name                         String
  seats                        Int
  frontSeats                   Int     @default(2) // includes the driver's seat
  hasTowHitch                  Boolean @default(false)
  travelTimeMinutes            Int?
  travelTimeWithTrailerMinutes Int?

  tripVehicles TripVehicle[]
}

model Trailer {
  id          String      @id @default(cuid())
  adminUserId String
  name        String
  type        TrailerType
  capacity    Int?

  tripTrailers TripTrailer[]
}

// ---- Trip + participation (a person/vehicle/trailer opting into one trip) ----

model Trip {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  shareToken  String    @unique @default(cuid())
  adminUserId String
  createdAt   DateTime  @default(now())

  participants TripParticipant[]
  tripVehicles TripVehicle[]
  tripTrailers TripTrailer[]
  variants     Variant[]
}

model TripParticipant {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id])
  hasBike  Boolean @default(false)

  createdVariants   Variant[]          @relation("VariantCreator")
  personAssignments PersonAssignment[]
  bikeAssignments   BikeAssignment[]
  votes             Vote[]

  @@unique([tripId, personId])
}

model TripVehicle {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  personAssignments  PersonAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]

  @@unique([tripId, vehicleId])
}

model TripTrailer {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  trailerId String
  trailer   Trailer @relation(fields: [trailerId], references: [id])

  trailerAssignments TrailerAssignment[]
  bikeAssignments    BikeAssignment[]

  @@unique([tripId, trailerId])
}

// ---- Variants (assignment proposals) ----

model Variant {
  id                     String          @id @default(cuid())
  tripId                 String
  trip                   Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name                   String
  createdByParticipantId String
  createdBy              TripParticipant @relation("VariantCreator", fields: [createdByParticipantId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  personAssignments  PersonAssignment[]
  bikeAssignments    BikeAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]
  votes              Vote[]
}

model PersonAssignment {
  id                String          @id @default(cuid())
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripParticipantId String
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  tripVehicleId     String
  tripVehicle       TripVehicle     @relation(fields: [tripVehicleId], references: [id])
  row               SeatRow
  isDriver          Boolean         @default(false)

  @@unique([variantId, tripParticipantId])
}

// A bike belongs to a trip participant (only meaningful when hasBike=true).
// Bikes only ever attach to a BIKE_RACK trailer, never directly to a vehicle.
model BikeAssignment {
  id                String          @id @default(cuid())
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripParticipantId String
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  tripTrailerId     String
  tripTrailer       TripTrailer     @relation(fields: [tripTrailerId], references: [id])

  @@unique([variantId, tripParticipantId])
}

model TrailerAssignment {
  id            String      @id @default(cuid())
  variantId     String
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripTrailerId String
  tripTrailer   TripTrailer @relation(fields: [tripTrailerId], references: [id])
  tripVehicleId String
  tripVehicle   TripVehicle @relation(fields: [tripVehicleId], references: [id])

  @@unique([variantId, tripTrailerId])
}

model VariantVehiclePlan {
  id                        String      @id @default(cuid())
  variantId                 String
  variant                   Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tripVehicleId             String
  tripVehicle               TripVehicle @relation(fields: [tripVehicleId], references: [id])
  departureTime             DateTime?
  travelTimeOverrideMinutes Int?

  @@unique([variantId, tripVehicleId])
}

model Vote {
  id                String          @id @default(cuid())
  tripId            String
  tripParticipantId String          @unique
  tripParticipant   TripParticipant @relation(fields: [tripParticipantId], references: [id])
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @updatedAt

  @@index([tripId])
}
