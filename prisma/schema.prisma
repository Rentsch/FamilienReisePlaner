// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  shareToken  String    @default(cuid()) @unique
  adminUserId String // Supabase auth.users.id
  createdAt   DateTime  @default(now())

  people   Person[]
  vehicles Vehicle[]
  trailers Trailer[]
  bikes    Bike[]
  variants Variant[]
}

model Person {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  canDrive Boolean @default(false)

  bikes           Bike[]
  createdVariants Variant[]          @relation("VariantCreator")
  assignments     PersonAssignment[]
  votes           Vote[]

  @@unique([tripId, name])
}

enum TrailerType {
  CARGO
  BIKE_RACK
}

model Vehicle {
  id                           String  @id @default(cuid())
  tripId                       String
  trip                         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name                         String
  seats                        Int
  hasTowHitch                  Boolean @default(false)
  travelTimeMinutes            Int?
  travelTimeWithTrailerMinutes Int?

  personAssignments  PersonAssignment[]
  bikeAssignments    BikeAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]
}

model Trailer {
  id       String      @id @default(cuid())
  tripId   String
  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  type     TrailerType
  capacity Int?

  trailerAssignments TrailerAssignment[]
  bikeAssignments    BikeAssignment[]
}

model Bike {
  id            String  @id @default(cuid())
  tripId        String
  trip          Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ownerPersonId String?
  owner         Person? @relation(fields: [ownerPersonId], references: [id])
  label         String?

  assignments BikeAssignment[]
}

model Variant {
  id                String   @id @default(cuid())
  tripId            String
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name              String
  createdByPersonId String
  createdBy         Person   @relation("VariantCreator", fields: [createdByPersonId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  personAssignments  PersonAssignment[]
  bikeAssignments    BikeAssignment[]
  trailerAssignments TrailerAssignment[]
  vehiclePlans       VariantVehiclePlan[]
  votes              Vote[]
}

model PersonAssignment {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([variantId, personId])
}

model BikeAssignment {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  @@unique([variantId, bikeId])
}

model TrailerAssignment {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  trailerId String
  trailer   Trailer @relation(fields: [trailerId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([variantId, trailerId])
}

model VariantVehiclePlan {
  id                        String    @id @default(cuid())
  variantId                 String
  variant                   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vehicleId                 String
  vehicle                   Vehicle   @relation(fields: [vehicleId], references: [id])
  departureTime             DateTime?
  travelTimeOverrideMinutes Int?

  @@unique([variantId, vehicleId])
}

model Vote {
  id        String   @id @default(cuid())
  tripId    String
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([tripId, personId])
}
